# Environment Configuration
# Copy this file to .env and fill in your credentials

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketlens
DB_USER=marketlens_user
DB_PASSWORD=marketlens_pass

# Gemini AI (optional — for AI Business Insights)
GEMINI_API_KEY=your_gemini_api_key_here

# App Settings
APP_ENV=development
LOG_LEVEL=INFO
